# ── Secrets — NEVER commit ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Database — contains real user data ────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Python bytecode ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
debug.log

# ── Python virtual environments ───────────────────────────────────────────────
venv/
.venv/
env/

# ── Runtime-generated images (recreated by server on demand) ──────────────────
backend/static/

# ── Flutter / Dart build + generated files ────────────────────────────────────
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies

# ── Android — machine-specific local config ───────────────────────────────────
frontend/android/local.properties
frontend/android/.gradle/
frontend/android/.kotlin/

# ── IDE project files ─────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
